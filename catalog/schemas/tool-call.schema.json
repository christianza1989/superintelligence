{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_version": {
      "type": "string",
      "minLength": 1
    },
    "module_release": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "type": "string",
          "minLength": 1
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "lease_id",
        "fencing_token"
      ]
    },
    "permission_grant_id": {
      "type": "string",
      "minLength": 1
    },
    "budget_reservation_id": {
      "type": "string",
      "minLength": 1
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "input": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "step_id",
    "attempt_id",
    "capability_id",
    "capability_version",
    "module_release",
    "idempotency_key",
    "lease",
    "permission_grant_id",
    "budget_reservation_id",
    "deadline",
    "input"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superintelligence:tool-call:1"
}
