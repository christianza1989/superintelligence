{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "experimental",
        "verified",
        "recommended",
        "deprecated"
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "repository",
        "revision"
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code_spdx": {
          "type": "string",
          "minLength": 1
        },
        "model_licenses_verified": {
          "type": "boolean"
        },
        "third_party_notices_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "code_spdx",
        "model_licenses_verified",
        "third_party_notices_verified"
      ]
    },
    "core_compatibility": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "contract_version": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "string",
            "minLength": 1
          },
          "output_schema": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "contract_version",
          "input_schema",
          "output_schema"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "python_worker",
            "node_worker",
            "native_worker",
            "http_service",
            "vm_worker"
          ]
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "node_engine": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependency_lock": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "integrity": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_mapping_verified": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "version",
            "integrity",
            "source_mapping_verified"
          ]
        },
        "tool_discovery_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "entrypoint",
        "dependency_lock",
        "artifact_digests"
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_side_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "network",
        "files_read",
        "files_write",
        "secrets",
        "external_side_effects"
      ]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_limit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ram_limit_mb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gpu": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "installed_bytes_measured": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_bytes_measured": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_limit_mb": {
          "type": "number",
          "minimum": 0
        },
        "estimates_are_measured": {
          "type": "boolean"
        }
      },
      "required": [
        "cpu_limit",
        "ram_limit_mb",
        "gpu",
        "installed_bytes_measured",
        "model_bytes_measured",
        "cache_limit_mb",
        "estimates_are_measured"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "cancellation": {
          "type": "string",
          "minLength": 1
        },
        "idempotency": {
          "type": "string",
          "minLength": 1
        },
        "healthcheck": {
          "type": "string",
          "minLength": 1
        },
        "error_contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "timeout_seconds",
        "max_attempts",
        "cancellation",
        "idempotency",
        "healthcheck",
        "error_contract"
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptance_suite": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trusted_suite_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "evaluator_image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_artifact": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "acceptance_suite",
        "requires"
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "string",
          "minLength": 1
        },
        "update": {
          "type": "string",
          "minLength": 1
        },
        "uninstall": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "install",
        "update",
        "uninstall"
      ]
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "blocking_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowed",
        "blocking_checks"
      ]
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pricing_status",
        "external_paid_calls_allowed",
        "unit_rate_usd",
        "model_provider_cost_separate",
        "local_compute_cost_measured"
      ],
      "properties": {
        "pricing_status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "external_paid_calls_allowed": {
          "type": "boolean"
        },
        "unit_rate_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "model_provider_cost_separate": {
          "type": "boolean"
        },
        "local_compute_cost_measured": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "manifest_version",
    "id",
    "version",
    "status",
    "upstream",
    "license",
    "core_compatibility",
    "platforms",
    "capabilities",
    "runtime",
    "permissions",
    "authentication",
    "resources",
    "execution",
    "tests",
    "lifecycle",
    "activation",
    "costs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superintelligence:module-manifest:0.1",
  "title": "Draft module manifest, structural checks only",
  "allOf": [
    {
      "if": {
        "properties": {
          "activation": {
            "properties": {
              "allowed": {
                "const": true
              }
            },
            "required": [
              "allowed"
            ]
          }
        },
        "required": [
          "activation"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "recommended"
            ]
          },
          "activation": {
            "properties": {
              "blocking_checks": {
                "maxItems": 0
              }
            }
          },
          "runtime": {
            "properties": {
              "dependency_lock": {
                "type": "string",
                "minLength": 1
              },
              "artifact_digests": {
                "minItems": 1
              }
            },
            "required": [
              "dependency_lock",
              "artifact_digests"
            ]
          },
          "resources": {
            "properties": {
              "installed_bytes_measured": {
                "type": "integer",
                "minimum": 0
              },
              "model_bytes_measured": {
                "type": "integer",
                "minimum": 0
              },
              "estimates_are_measured": {
                "const": true
              }
            }
          },
          "license": {
            "properties": {
              "model_licenses_verified": {
                "const": true
              },
              "third_party_notices_verified": {
                "const": true
              }
            }
          },
          "tests": {
            "required": [
              "trusted_suite_revision",
              "evaluator_image_digest",
              "evidence_artifact"
            ]
          }
        }
      }
    }
  ]
}
