{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superintelligence:document.extract_tables.input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "include_page_provenance"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "include_page_provenance": {
      "const": true
    }
  }
}
