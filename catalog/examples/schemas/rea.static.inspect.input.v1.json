{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superintelligence:rea.static.inspect.input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "questions"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  }
}
