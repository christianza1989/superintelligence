{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "repositoryzero",
  "version": "0.11.1",
  "description": "RepositoryZero source discovery by default; optional operator-bound Linux CSV, PDF and approved URL research jobs through the existing Zero backend.",
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "requires_local_executor": true,
      "interface": {
        "displayName": "RepositoryZero",
        "shortDescription": "Find reusable source components",
        "developerName": "RepositoryZero contributors",
        "capabilities": [
          "Read",
          "Write"
        ]
      }
    }
  }
}
