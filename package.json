{
  "name": "repositoryzero",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "setup:mcp": "node scripts/platform.mjs install --frozen-lockfile --ignore-scripts --filter @rakazo/adapters... --filter @rakazo/testkit...",
    "mcp:serve": "node scripts/zero-mcp.mjs",
    "test:mcp": "node scripts/platform.mjs exec vitest run packages/adapters/src/zero-mcp-server.test.ts packages/adapters/src/zero-mcp-stdio.test.ts",
    "test:observer": "node scripts/platform.mjs exec vitest run packages/adapters/src/pi-runtime-fallback.test.ts packages/adapters/src/pi-usage.test.ts packages/adapters/src/pi-runtime-provider-prefix.test.ts packages/adapters/src/pi-cache-protocol.test.ts",
    "test:scope": "node scripts/platform.mjs exec vitest run packages/adapters/src/zero-project-snapshot.test.ts packages/adapters/src/file-handle-path.test.ts",
    "test:worker": "node scripts/platform.mjs exec vitest run packages/adapter-kit/src/background-jobs.test.ts packages/adapters/src/zero-csv-profile.test.ts packages/adapters/src/wakeup-graphile-host.test.ts packages/adapters/src/wakeup.test.ts",
    "test:csv:postgres": "node scripts/platform.mjs exec vitest run packages/adapters/src/zero-csv-preparation.postgres.test.ts",
    "test:csv:api": "node scripts/platform.mjs exec vitest run apps/api/src/zero-csv.postgres.test.ts",
    "check:zero": "node scripts/platform.mjs --filter @rakazo/adapter-kit --filter @rakazo/adapters check",
    "setup": "node scripts/platform.mjs install --frozen-lockfile --ignore-scripts --filter @rakazo/web... --filter @rakazo/www... --filter @rakazo/api... --filter @rakazo/worker... --filter @rakazo/testkit...",
    "dev": "node scripts/platform.mjs --filter @rakazo/web dev",
    "dev:site": "node scripts/platform.mjs --filter @rakazo/www dev --host 127.0.0.1 --port 4321",
    "build:web": "node scripts/platform.mjs --filter @rakazo/web build",
    "build:site": "node scripts/platform.mjs --filter @rakazo/www build",
    "check:web": "node scripts/platform.mjs --filter @rakazo/web check",
    "test:foundation": "node scripts/platform.mjs exec vitest run packages/core/src/zero-catalog.test.ts packages/adapters/src/zero-tool-selector.test.ts packages/adapters/src/zero-systemone.test.ts packages/adapters/src/zero-model-selector.test.ts packages/adapters/src/zero-repository-selector.test.ts packages/adapters/src/zero-repository-tools.test.ts packages/ui-tokens/src/appearance.test.ts apps/web/src/lib/ui-appearance.test.ts apps/web/src/lib/ui-locale.test.ts packages/adapters/src/pi-runtime-tool-schema.test.ts",
    "db:generate": "node scripts/platform.mjs --filter @rakazo/db generate",
    "catalog:sync": "node platform/scripts/sync-zero-catalog.mjs",
    "init:local": "node scripts/init-local.mjs",
    "db:up": "node scripts/local-db.mjs",
    "db:migrate": "node scripts/platform.mjs --filter @rakazo/db migrate",
    "dev:api": "node scripts/platform.mjs --filter @rakazo/api dev",
    "dev:worker": "node scripts/platform.mjs --filter @rakazo/worker dev",
    "db:status": "node scripts/local-db.mjs status",
    "test:durability": "node platform/scripts/verify-zero-foundation.mjs",
    "test:budgets": "node platform/scripts/verify-zero-foundation.mjs --budget",
    "demo:reuse": "node platform/scripts/zero-self-reuse.mjs",
    "test:reuse-build": "node platform/scripts/verify-reuse-build.mjs",
    "check:jev-repo": "node scripts/platform.mjs exec tsx scripts/verify-jev-repository.mjs",
    "lab:plan": "node scripts/platform.mjs exec tsx scripts/zero-lab-plan.mjs",
    "test:codex-bridge": "node --test platform/scripts/zero-codex-cli.test.mjs",
    "test:claude-bridge": "node --test platform/scripts/zero-claude-cli.test.mjs",
    "lab:run": "node scripts/platform.mjs exec tsx scripts/zero-lab-run.mjs",
    "test:lab": "node scripts/platform.mjs exec tsx --test scripts/zero-lab-run.test.mjs",
    "package:local": "node platform/scripts/package-local-source.mjs",
    "test:lab-evaluator": "node --test platform/scripts/zero-lab-evaluate.test.mjs",
    "test:lab-docker": "ZERO_LAB_DOCKER_TESTS=1 node --test platform/scripts/zero-lab-evaluate.test.mjs",
    "lab:prepare": "node platform/scripts/zero-lab-prepare.mjs",
    "lab:compare": "node platform/scripts/zero-lab-compare.mjs",
    "test:lab-compare": "node --test platform/scripts/zero-lab-compare.test.mjs",
    "test:lab-acceptance": "node --test platform/scripts/zero-lab-acceptance.test.mjs",
    "test:lab-browser": "node --test platform/scripts/zero-lab-browser.test.mjs",
    "test:lab-browser-docker": "ZERO_LAB_BROWSER_DOCKER_TESTS=1 node --test platform/scripts/zero-lab-browser.test.mjs",
    "test:lab-prepare": "node --test platform/scripts/zero-lab-prepare.test.mjs",
    "lab:cohort": "node scripts/platform.mjs exec tsx scripts/zero-lab-cohort.mjs",
    "test:lab-cohort": "node scripts/platform.mjs exec tsx --test scripts/zero-lab-cohort.test.mjs",
    "test:lab-context": "node --test platform/scripts/zero-lab-context.test.mjs",
    "lab:jev-prepare": "node scripts/platform.mjs exec tsx scripts/zero-lab-jev.mjs",
    "test:lab-reuse": "node scripts/platform.mjs exec tsx --test scripts/zero-lab-reuse.test.mjs",
    "lab:stockdesk": "node scripts/platform.mjs exec tsx scripts/zero-stockdesk-run.mjs",
    "lab:stockdesk-prepare": "node scripts/platform.mjs exec tsx scripts/zero-stockdesk-prepare.mjs",
    "test:stockdesk": "node scripts/platform.mjs exec tsx --test scripts/zero-stockdesk.test.mjs",
    "test:stockdesk-docker": "ZERO_STOCKDESK_DOCKER_TESTS=1 node scripts/platform.mjs exec tsx --test scripts/zero-stockdesk.test.mjs",
    "docs:sync": "node scripts/docs.mjs --write",
    "check:docs": "node scripts/docs.mjs"
  }
}
